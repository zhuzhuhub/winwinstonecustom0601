---
import SectionHeader from "../common/SectionHeader.astro";
import ProductPagination from "../category/ProductPagination.astro";

const {
  products = [],
  category = "",
  title = "Featured Products",
  description = "Browse our custom stone products.",
  currentPage = 1,
  totalPages = 1,
} = Astro.props;
---

<section class="featured-products">

  <div class="container">

    <SectionHeader
      title={title}
      description={description}
    />

    <div class="product-grid">

      {products.map((product) => {

        const slug =
          product.id
            .split("/")
            .pop();

        return (

          <a
            href={`/${category}/${slug}/`}
            class="product-card"
          >

            <div class="product-image">

              <img
                src={product.data.featuredImage}
                alt={product.data.title}
                loading="lazy"
              />

            </div>

            <div class="product-content">

              <h3>
                {product.data.title}
              </h3>

              <p>
                {product.data.description}
              </p>

              <span class="product-link">
                Explore →
              </span>

            </div>

          </a>

        );

      })}

    </div>

    {totalPages > 1 && (
      <ProductPagination
        currentPage={currentPage}
        totalPages={totalPages}
        category={category}
      />
    )}

  </div>

</section>