---
import SectionHeader from "../common/SectionHeader.astro";

const {
  title = "Frequently Asked Questions",
  description = "",
  items = []
} = Astro.props;
---

<section class="category-faq">
  <div class="container">
    <SectionHeader
      title={title}
      description={description}
    />

    <div class="faq-list">
      {items.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>