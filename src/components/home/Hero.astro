---
import heroImage from "../../assets/home/hero-bg.jpg";

import Button from "../Button.astro";
---

<section
  class="hero"
  style={`background-image:url(${heroImage.src})`}
>

  <div class="hero-overlay"></div>

  <div class="container hero-container">

    <div class="hero-content">

      <!-- Eyebrow -->

      <span class="hero-eyebrow">
        CUSTOM NATURAL STONE PRODUCTS · YUNFU, CHINA
      </span>

      <!-- Main Heading -->

      <h1>
        Custom Natural Stone Products
        for Global Brands & Projects
      </h1>

      <!-- Description -->

      <p class="hero-description">

        We develop and supply bespoke marble furniture,stone tables,
        stone sinks,stone bathtubs and architectural stone products.
        With access to Yunfu's integrated stone manufacturing
        resources, we support brands, wholesalers, designers
        and project buyers from material selection to custom
        fabrication and international delivery.

      </p>

      <!-- CTA -->

      <div class="hero-actions">

        <Button
          href="/contact/"
          variant="primary"
          size="large"
        >
          Request a Quote
        </Button>

        <Button
          href="/stone-tables/"
          variant="secondary"
          size="large"
        >
          Explore Products
        </Button>

      </div>

      <!-- Trust Points -->

      <div class="hero-points">

        <div>
          15+ Years of Stone Experience
        </div>

        <div>
          OEM / ODM Product Development
        </div>

        <div>
          Global Export Support
        </div>

      </div>

    </div>

  </div>

</section>
