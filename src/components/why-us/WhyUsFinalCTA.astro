---
import Button from "../Button.astro";
---

<section class="why-final-cta section">
  <div class="container">
    <div class="why-final-cta__box">
      <div class="why-final-cta__content">
        <h2>
          Planning A Custom Stone Product
          Or Project Inquiry?
        </h2>

        <p>
          Share your drawings, reference images, product specifications, or
          project requirements. We’ll review the details and discuss suitable
          stone, production options, and quotation support.
        </p>
      </div>

      <div class="why-final-cta__actions">
        <Button
          href="/contact/"
          variant="primary"
          size="large"
        >
          Get A Free Quote
        </Button>

        <a
          href="https://wa.me/8613927192948"
          target="_blank"
          rel="noopener noreferrer"
          class="why-final-cta__whatsapp"
        >
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>