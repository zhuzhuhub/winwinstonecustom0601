---
import SectionHeader from "../SectionHeader.astro";

const faqs = [
  {
    question: "What is your MOQ?",
    answer:
      "MOQ can start from a single piece depending on the product."
  },
  {
    question: "Can you customize dimensions?",
    answer:
      "Yes. Most products can be manufactured to custom sizes based on your project requirements."
  },
  {
    question: "Do you ship worldwide?",
    answer:
      "Yes. We regularly export to Europe, North America, Australia, and other regions."
  },
  {
    question: "How long is production?",
    answer:
      "Lead time depends on product complexity, stone selection, quantity, and the current production schedule."
  }
];
---

<section class="contact-faq section">
  <div class="container">
    <SectionHeader
      title="Frequently Asked Questions"
      description="Quick answers to common questions from architects, designers, distributors, and project buyers."
    />

    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>