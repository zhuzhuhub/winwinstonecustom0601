---
import Button from "../Button.astro";
---

<section class="oem-cta section">
  <div class="container">
    <div class="oem-cta-box">
      <p class="oem-cta__eyebrow">Start Your OEM Project</p>

      <h2>
        Send Your Drawings, Dimensions
        Or Reference Images For Review
      </h2>

      <p class="oem-cta__description">
        If you are developing a custom stone sink, table, bathtub, fireplace
        surround, or other stone product, send us your drawings, reference
        images, dimensions, or target materials. We can review feasibility,
        recommend suitable options, and support quotation preparation.
      </p>

      <div class="oem-cta__tags">
        <span>Drawing Review</span>
        <span>Material Suggestions</span>
        <span>Production Assessment</span>
        <span>Quotation Support</span>
      </div>

      <div class="oem-cta__actions">
        <Button href="/contact/" variant="primary" size="large">
          Get A Free Quote
        </Button>

        <a
          href="https://wa.me/8613927192948"
          target="_blank"
          rel="noopener noreferrer"
          class="whatsapp-button"
        >
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>