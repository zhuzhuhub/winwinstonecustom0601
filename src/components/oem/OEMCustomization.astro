---

<section class="oem-customization section">
  <div class="container">
    <div class="oem-section-heading">
      <p class="oem-section-heading__eyebrow">
        What Can Be Customized
      </p>

      <h2>
        Flexible OEM Development Across
        Size, Stone, Finish And Product Details
      </h2>

      <p>
        We work with project requirements, product drawings, and reference
        samples to help adjust practical details that affect product appearance,
        usability, installation, and packaging presentation.
      </p>
    </div>

    <div class="oem-custom-grid">
      {customizationItems.map((item) => (
        <article class="oem-custom-card">
          <div class="oem-custom-card__image">
            <img
              src={item.image}
              alt={item.alt}
              loading="lazy"
            />
          </div>

          <div class="oem-custom-card__content">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>