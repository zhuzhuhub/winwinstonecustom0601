    alt: "Custom stone product dimensions and proportions"
  },
  {
    title: "Stone Material Selection",
    description:
      "Choose from travertine, marble, limestone, onyx, and other natural stones based on appearance, application, durability, and project positioning.",
    image: "/images/oem/customization/oem-material.jpg",
    alt: "Stone material selection for OEM stone products"
  },
  {
    title: "Surface Finish",
    description:
      "Polished, honed, brushed, leathered, fluted, and other surface treatments can be selected to suit the desired visual style and tactile effect.",
    image: "/images/oem/customization/oem-finish.jpg",
    alt: "Surface finish options for custom stone products"
  },
  {
    title: "Edge Profiles & Details",
    description:
      "Edge shapes, corner detailing, bevels, grooves, and other crafted features can be refined to align with your product language and design intent.",
    image: "/images/oem/customization/oem-edge.jpg",
    alt: "Edge profile and crafted details for stone products"
  },
  {
    title: "Functional Product Features",
    description:
      "Sink cutouts, drainage layouts, mounting structures, integrated basins, tabletop construction details, and other practical features can be adapted to project needs.",
    image: "/images/oem/customization/oem-features.jpg",
    alt: "Functional features for OEM stone sinks and furniture"
