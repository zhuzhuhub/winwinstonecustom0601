---
import BaseLayout from "../../layouts/BaseLayout.astro";

import ProductHero from "../../components/product/ProductHero.astro";
import ProductSpecifications from "../../components/product/ProductSpecifications.astro";
import ProductInquiryCTA from "../../components/product/ProductInquiryCTA.astro";
import RelatedProducts from "../../components/product/RelatedProducts.astro";
import ProductFeatures from "../../components/product/ProductFeatures.astro";

import ProductTableOfContents from "../../components/product/ProductTableOfContents.astro";
import ProductRelatedResources from "../../components/product/ProductRelatedResources.astro";

import { buildProductSchema } from "../../lib/schema/product";

// 动态生成路径
export async function getStaticPaths() {
  const modules = import.meta.glob("../../content/products/**/*.md", { eager: true });
  return Object.keys(modules)
    .filter(key => key.includes("stone-tables"))
    .map(key => {
      const slug = key.split("/").pop()?.replace(".md", "");
      return { params: { slug } };
    });
}

const slug = Astro.params.slug;

// 顶层模块读取
const allModules = import.meta.glob("../../content/products/**/*.md", { eager: true });
const moduleKey = Object.keys(allModules).find(key => key.includes(`stone-tables/${slug}`));

if (!moduleKey) {
  throw Astro.redirect("/404");
}

const module = allModules[moduleKey] as {frontmatter: any;Content: any;};

const { frontmatter, Content } = module;

// 解构 frontmatter，变量名统一
const {
  title,
  description,

  featuredImage,
  featureImage,
  featureVideo,
  featureVideoPoster,
  gallery,

  seoTitle,
  seoDescription,

  categoryLabel,
  heroBadges,

  featureHeading,
  featureDescription,

  keyFeatures,

  material,
  finish,

  moq,
  leadTime

} = frontmatter;

const siteUrl = import.meta.env.SITE || 'https://www.winwinstonecustom.com';

function absUrl(path: string) {
  if (!path) return undefined;
  if (/^https?:\/\//.test(path)) return path;
  return siteUrl.replace(/\/$/, '') + (path.startsWith('/') ? path : '/' + path);
}

const breadcrumbs = [
  { name: 'Home', url: siteUrl + '/' },
  { name: 'Stone Tables', url: siteUrl + '/stone-tables/' },
  { name: title, url: `${siteUrl}/stone-tables/${slug}` }
];

const allProducts =
  Object.values(allModules);

const productSchema = buildProductSchema({
  title,
  description,

  image: featuredImage
    ? [
        absUrl(featuredImage),
        ...(gallery?.map((g) => absUrl(g.image)) ?? []),
      ]
    : undefined,

  sku: frontmatter.sku,

  brand: frontmatter.brand,

  material,

  finish,

  category: categoryLabel,

  moq,
  leadTime,

  url: `${siteUrl}/stone-sinks/${slug}/`,
});

const tocItems = [
  {
    id: "product-overview",
    title: "Product Overview",
  },
  {
    id: "available-stone-materials",
    title: "Available Stone Materials",
  },
  {
    id: "surface-finish-options",
    title: "Surface Finish Options",
  },
  {
    id: "custom-manufacturing-options",
    title: "Custom Manufacturing Options",
  },
  {
    id: "recommended-applications",
    title: "Recommended Applications",
  },
  {
    id: "packaging-global-shipping",
    title: "Packaging & Global Shipping",
  },
  {
    id: "why-work-with-win-win-stone",
    title: "Why Work With Win-Win Stone",
  },
];

const relatedResources = [

  {
    type: "Blog",
    title: "How to Choose the Right Stone Table",
    description:
      "Learn how to choose materials, finishes and table styles for spaces.",
    href: "/blog/how-to-custom-stone-dining-tables-for-hospitality-and-villa-projects/",
  },

  {
    type: "Material",
    title: "Natural Marble Collection",
    description:
      "Explore premium marble materials available for custom table manufacturing.",
    href: "/materials/",
  },

  {
    type: "OEM",
    title: "Custom OEM Manufacturing",
    description:
      "Discover our OEM & ODM production capabilities for global projects.",
    href: "/oem-odm/",
  },

  {
    type: "Factory",
    title: "Inside Our Stone Factory",
    description:
      "See how every natural stone product is handcrafted by experienced artisans.",
    href: "/factory/",
  }

];

---

<BaseLayout
  title={seoTitle}
  description={seoDescription}

  image={featuredImage}

  >


<ProductHero
  title={title}
  description={description}

  material={material}

  moq={moq}
  leadTime={leadTime}

  categoryLabel={categoryLabel}
  heroBadges={heroBadges}

  featuredImage={featuredImage}
  gallery={gallery}
/>

<section class="product-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/stone-tables/">Stone Tables</a>
        <span>/</span>
        <span>{title}</span>
      </nav>

      <div class="product-grid">
        <div class="product-gallery">
            
          <div class="section-header product-section-header gallery-section-header">
           <h2>Material Details & Project Views</h2>
            <p class="lead">
              Explore detail shots, material close-ups, and project-oriented images of this custom stone table design.
            </p>
          </div>


     <div class="gallery-slider">

      {
       gallery?.map((item) => (

      <a
       href={item.image}
       class="gallery-slide glightbox"
       data-gallery="product-gallery"
      >

          <img
            src={item.image}
            alt={title}
            loading="lazy"
          />

        </a>

       ))
      }

      </div>

    </div>

        
      </div>
    </div>
   </section>

   <ProductFeatures
    features={keyFeatures}
    image={featureImage}
    video={featureVideo}
    videoPoster={featureVideoPoster}
    heading={featureHeading}
    description={featureDescription}
  />


  <ProductSpecifications
    material={material}
    finish={finish}
    moq={moq}
    leadTime={leadTime}
  />
 
  <section class="product-content">

   <div class="container">
     <div class="product-content-header">

      <h2>Product Details</h2>

      <p>
       Learn more about the design, craftsmanship,
       customization options, and applications
       of this custom natural stone table.
      </p>

     </div>

     <ProductTableOfContents items={tocItems} />

     <article class="product-prose">

       <Content />

    </article>

  </div>

</section>

  <ProductRelatedResources
    resources={relatedResources}
  />
  
  <ProductInquiryCTA
    productTitle={title}
    slug={slug}
  />

  <RelatedProducts
    products={allProducts}
    currentSlug={slug}
    category="stone-tables"
  />


  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: b.name,
      item: b.url
    }))
  })} />

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

 
</BaseLayout>
