---
import BaseLayout from "../../layouts/BaseLayout.astro";


import Hero from "../../components/category/Hero.astro";
import Advantages from "../../components/category/Advantages.astro";
import { stoneTablesData } from "../../data/categories/stone-tables";

import Customization from "../../components/category/Customization.astro";

import FeaturedProducts from "../../components/category/FeaturedProducts.astro";

import Applications from "../../components/category/Applications.astro";

import FAQ from "../../components/category/FAQ.astro";

import FinalCTA from "../../components/category/FinalCTA.astro";

import { getCollection } from "astro:content";

import {
  buildItemListSchema,
  buildCollectionSchema,
} from "../../lib/schema/category";


const category = "stone-tables";

const siteUrl = (
  import.meta.env.SITE ??
  "https://www.winwinstonecustom.com"
).replace(/\/$/, "");

  // 获取所有产品
const products = await getCollection("products");

// 过滤 Stone Tables 分类产品
const stoneTables = products.filter(
  (p) => p.data.category === category
);

const itemListSchema = buildItemListSchema({
  category,
  products: stoneTables,
  baseUrl: siteUrl
});

const collectionSchema = buildCollectionSchema({
  name: "Custom Stone Tables",
  description:
    "Custom marble tables, travertine dining tables, stone coffee tables, side tables and natural stone furniture for luxury interior projects.",
  url: `${siteUrl}/stone-tables/`,
});

---
<BaseLayout
  title="Custom Stone Dining Tables & Coffee Tables | Stone Table OEM"
  description="Custom marble and travertine stone tables including dining tables, coffee tables and side tables. We create luxury stone furniture for villas, hotels, designers and commercial projects worldwide."
>

  <Hero
  eyebrow="CUSTOM STONE TABLE OEM MANUFACTURER"
  title="Custom Stone Dining Tables for Luxury Interiors"
  description="Custom marble and travertine dining tables, coffee tables,console tables and bespoke stone furniture manufactured for luxury residential, hospitality and commercial projects worldwide."
  backgroundImage="/images/categories/stone-tables-hero.jpg"
  />

  <Advantages
  title="Why Choose Our Custom Stone Tables"
  description="Built for luxury residential, hospitality and commercial furniture projects."
  items={stoneTablesData.advantages}
  />
  
  <FeaturedProducts
  products={stoneTables}
  category="stone-tables"
  title="Custom Marble & Stone Table Collection"
  description="Explore custom marble dining tables, travertine coffee tables and natural stone furniture designed for luxury interiors."
  />
  
  <Customization
  title="Customization Options"
  description="Tailor every detail of your stone table project."
  items={stoneTablesData.customization}
  />
  
  <Applications
  title="Custom Stone Table Applications"
  description="Custom stone tables designed for luxury villas, hotels, restaurants and commercial interior projects worldwide."
  items={stoneTablesData.applications}
  />

  <FAQ
  title="Frequently Asked Questions"
  description="Answers to common questions about custom stone table manufacturing."
  items={stoneTablesData.faq}
  />

  <FinalCTA
  title={stoneTablesData.cta.title}
  description={stoneTablesData.cta.description}
  buttonText={stoneTablesData.cta.buttonText}
  buttonLink={stoneTablesData.cta.buttonLink}
  />

  <script
  type="application/ld+json"
  set:html={JSON.stringify(itemListSchema)}
  />

  <script
  type="application/ld+json"
  set:html={JSON.stringify(collectionSchema)}
/>

</BaseLayout>