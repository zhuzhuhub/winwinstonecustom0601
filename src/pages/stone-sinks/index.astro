---
import BaseLayout from "../../layouts/BaseLayout.astro";

import Hero from "../../components/category/Hero.astro";
import { stoneSinksData } from "../../data/categories/stone-sinks";
import Advantages from "../../components/category/Advantages.astro";
import Customization from "../../components/category/Customization.astro";
import FeaturedProducts from "../../components/category/FeaturedProducts.astro";
import Applications from "../../components/category/Applications.astro";
import FAQ from "../../components/category/FAQ.astro";
import FinalCTA from "../../components/category/FinalCTA.astro";

import { getCollection } from "astro:content";

import {
  buildItemListSchema,
  buildCollectionSchema,
} from "../../lib/schema/category";

const category = "stone-sinks";

const siteUrl = (
  import.meta.env.SITE ??
  "https://www.winwinstonecustom.com"
).replace(/\/$/, "");

// 获取所有产品
const products = await getCollection("products");

// 过滤 Stone Sinks 分类产品
const stoneSinks = products.filter(
  (p) => p.data.category === category
);

const itemListSchema = buildItemListSchema({
  category,
  products:stoneSinks,
  baseUrl: siteUrl
});

const collectionSchema = buildCollectionSchema({
  name: "Stone Sinks",
  description:
    "Custom stone sinks handcrafted from natural marble, travertine and limestone. We create luxury bathroom basins for hotels, designers and residential projects worldwide.",
  url: `${siteUrl}/stone-sinks/`,
});

---
<BaseLayout
  title="Custom Stone Sinks & Natural Marble Basins | Luxury Bathroom OEM"
 description="Custom stone sinks handcrafted from natural marble, travertine and limestone. We create luxury bathroom basins with custom sizes and finishes for hotels, designers and residential projects worldwide."
>

  <Hero

  eyebrow="CUSTOM STONE SINK OEM"

  title="Custom Stone Sinks for Luxury Bathroom Projects"

  description="Win-Win Stone specializes in custom stone sinks crafted from natural marble, travertine and other premium stones. We support OEM projects for luxury residential, hospitality and commercial applications worldwide."
  backgroundImage="/images/categories/stone-sinks-hero.jpg"

/>

  <Advantages
  title={stoneSinksData.advantages.title}
  description={stoneSinksData.advantages.description}
  items={stoneSinksData.advantages.items}
  />
  
  <FeaturedProducts
  products={stoneSinks}
  category="stone-sinks"
  title="Custom Marble & Stone Sink Collection"
  description="Explore custom marble sinks, travertine basins and natural stone sinks designed for luxury bathrooms, hotels and interior projects."
  />
  
 <Customization
  title={stoneSinksData.customization.title}
  description={stoneSinksData.customization.description}
  items={stoneSinksData.customization.items}
  />

  <Applications
  title={stoneSinksData.applications.title}
  description={stoneSinksData.applications.description}
  items={stoneSinksData.applications.items}
  />

  <FAQ
  title={stoneSinksData.faq.title}
  description={stoneSinksData.faq.description}
  items={stoneSinksData.faq.items}
  />

 <FinalCTA
  title={stoneSinksData.cta.title}
  description={stoneSinksData.cta.description}
 />


<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

<script
  type="application/ld+json"
  set:html={JSON.stringify(collectionSchema)}
/>

</BaseLayout>